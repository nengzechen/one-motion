{
  "name": "one-motion-client",
  "type": "module",
  "version": "1.0.0",
  "description": "游戏存档云同步工具",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite build --config vite.electron.config.ts && concurrently \"vite --config vite.renderer.config.ts\" \"wait-on tcp:localhost:5173 && NODE_ENV=development electron .\"",
    "build": "vite build --config vite.electron.config.ts && vite build --config vite.renderer.config.ts && electron-builder",
    "preview": "vite preview --config vite.renderer.config.ts"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.7.0",
    "electron-store": "^8.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.onemotion.client",
    "productName": "OneMotion",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
